{
  "name": "zerox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b && eslint .",
    "preview": "vite preview",
    "dev:demo": "cross-env VITE_CLIENT_ID=demo vite",
    "build:demo": "cross-env VITE_CLIENT_ID=demo vite build --outDir dist/demo",
    "dev:tunnel": "cross-env VITE_CLIENT_ID=demo __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.trycloudflare.com vite",
    "dev:tunnel:seed": "cross-env VITE_CLIENT_ID=demo VITE_DEMO_SEED=1 __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.trycloudflare.com vite",
    "dev:dahjon": "cross-env VITE_CLIENT_ID=dahjon vite",
    "build:dahjon": "cross-env VITE_CLIENT_ID=dahjon vite build --outDir dist/dahjon"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "read-excel-file": "^9.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
